# TerraWatch configuration
# Copy this file to .env and adjust as needed. Every value below is optional.

APP_NAME=TerraWatch
APP_VERSION=2.0.0
DEBUG=False
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite by default; the file is created automatically)
DATABASE_URL=sqlite+aiosqlite:///./terrawatch.db

# CORS: comma-separated origins. Wildcards are allowed inside hostnames.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.hf.space

# Authentication is opt-in. When enabled, every /api route except the public
# health/info/data-quality endpoints requires X-API-Key (or ?api_key=).
API_AUTH_ENABLED=False
API_SECRET_KEY=

# Optional external API keys
FIRMS_MAP_KEY=              # NASA FIRMS area queries (free: firms.modaps.eosdis.nasa.gov)

# Feature flags
OPEN_METEO_ENABLED=True
USGS_API_ENABLED=True

# Cache
CACHE_PERSIST=True          # SQLite-backed L2 cache that survives restarts
CACHE_MAX_SIZE=1000

# Rate limiting (requests per minute per client IP, /api routes only)
RATE_LIMIT_PER_MINUTE=100

# Upstream HTTP timeouts (seconds)
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=12

# Background USGS polling interval (seconds)
EARTHQUAKE_FETCH_INTERVAL=300
